<circuit>
  <version>2</version>
  <attributes>
    <entry>
      <string>Description</string>
      <string>Referenzdemo: drei Wege berechnen denselben finalen Carry C8. Keine Summenbits. Alle Grundgatter haben 10 ns Laufzeit.</string>
    </entry>
    <entry>
      <string>timingClockPeriod</string>
      <int>2000</int>
    </entry>
    <entry>
      <string>timingDefaultDelay</string>
      <int>10</int>
    </entry>
    <entry>
      <string>Width</string>
